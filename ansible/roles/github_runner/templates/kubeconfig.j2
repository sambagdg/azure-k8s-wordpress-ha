apiVersion: v1
kind: Config
clusters:
  - name: projet-wordpress
    cluster:
      server: https://{{ private_ip }}:6443
      certificate-authority-data: {{ github_runner_ca.content }}
users:
  - name: github-deployer
    user:
      token: {{ github_runner_sa_token.stdout }}
contexts:
  - name: github-deployer
    context:
      cluster: projet-wordpress
      user: github-deployer
      namespace: gandega-project1
current-context: github-deployer
