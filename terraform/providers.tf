terraform {
  required_version = ">= 1.6"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
  }
}

# L'ID d'abonnement est lu dans la variable d'environnement ARM_SUBSCRIPTION_ID
provider "azurerm" {
  features {}
}
