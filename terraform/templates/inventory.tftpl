[control_plane]
%{ for name, vm in vms ~}
%{ if vm.role == "master" ~}
${name} ansible_host=${ips[name]} private_ip=${vm.private_ip}
%{ endif ~}
%{ endfor ~}

[workers]
%{ for name, vm in vms ~}
%{ if vm.role == "worker" ~}
${name} ansible_host=${ips[name]} private_ip=${vm.private_ip}
%{ endif ~}
%{ endfor ~}

[nfs_server]
worker2

[k8s_cluster:children]
control_plane
workers

[all:vars]
ansible_user=${admin_user}
ansible_ssh_private_key_file=~/.ssh/azure_k8s
ansible_python_interpreter=/usr/bin/python3
